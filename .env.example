# Clerk Dashboard → API keys → Publishable key (safe for the client bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Convex Dashboard → your development deployment → Settings → URL & Deploy Key
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
# Generated by `npx convex dev`, for example dev:your-deployment
CONVEX_DEPLOYMENT=

# Set CLERK_JWT_ISSUER_DOMAIN on the Convex deployment (not as EXPO_PUBLIC_*).
# Clerk Dashboard → Integrations → Convex must be enabled.

# Sentry source-map/debug-symbol uploads only; never use an EXPO_PUBLIC_ prefix.
# The wizard stores the real token in .env.local. Set it in each EAS build environment too.
SENTRY_AUTH_TOKEN=
